# Sinyal botu ayarları (sunucu her çalıştırmadan önce bu dosyanın GitHub'daki halini çeker)
# Bu dosyayı GitHub'da düzenleyebilirsin; değişiklik bir sonraki taramada (en geç 15 dk) geçerli olur.
# Gizli bilgiler (token, API anahtarı) BURAYA YAZILMAZ – onlar sunucudaki secrets.env dosyasında.

# Taranacak coinler (Gate.io formatı)
SYMBOLS="BTC_USDT, ETH_USDT, SOL_USDT, XRP_USDT, BNB_USDT, DOGE_USDT, ADA_USDT, AVAX_USDT, LINK_USDT, DOT_USDT, LTC_USDT, TRX_USDT, SUI_USDT, NEAR_USDT, APT_USDT, ARB_USDT, OP_USDT, ATOM_USDT, PEPE_USDT, SHIB_USDT"

# Zaman dilimleri
TIMEFRAMES="15m, 1h"

# Otomatik işlem: true = Binance'te işlem açar, false = sadece Telegram sinyali
TRADING_ENABLED=true

# DEMO hesap. Gerçek hesaba geçmek ayrı ve bilinçli bir adım olmalı.
BINANCE_BASE_URL=https://demo-fapi.binance.com
   RAPOR_ISTEGI=1
